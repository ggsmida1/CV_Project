/* ===== 全局样式 ===== */
QMainWindow {
    background-color: #2c3e50;
    color: #ecf0f1;
    border: 1px solid #f39c12;
}

QWidget {
    color: #ecf0f1;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
}

/* ===== 自定义标题栏 ===== */
#titleBar {
    background-color: #1a252f;
    border-bottom: 2px solid #f39c12;
    min-height: 38px;
    max-height: 38px;
}

#titleBar > QLabel {
    color: #ecf0f1;
    padding-left: 10px;
}

#lblTitleIcon {
    padding-left: 10px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
}

#lblTitle {
    color: #f39c12;
    font-size: 14px;
    font-weight: bold;
    padding-left: 4px;
}

/* 标题栏按钮 - 与titleBar等高，且无额外margin */
#btnMinimize, #btnMaximize, #btnClose {
    border: none;
    background-color: #1a252f;
    color: #ecf0f1;
    min-width: 46px;
    max-width: 46px;
    min-height: 36px;
    max-height: 36px;
    font-size: 14px;
    padding: 0px;
    margin: 0px;
}

#btnMinimize:hover, #btnMaximize:hover {
    background-color: #34495e;
    color: #f39c12;
}

#btnClose:hover {
    background-color: #e74c3c;
    color: #ffffff;
}

/* ===== 标签页样式 ===== */
QTabWidget::pane {
    border: 1px solid #34495e;
    background-color: #34495e;
    border-radius: 0;
    top: -1px;
}

QTabBar::tab {
    background-color: #2c3e50;
    color: #bdc3c7;
    padding: 12px 24px;
    margin-right: 0;
    border: none;
    border-bottom: 3px solid transparent;
    font-size: 14px;
    font-weight: bold;
}

QTabBar::tab:selected {
    background-color: #34495e;
    color: #f39c12;
    border-bottom: 3px solid #f39c12;
}

QTabBar::tab:hover:!selected {
    background-color: #34495e;
    color: #ecf0f1;
}

/* ===== 分组框样式 ===== */
QGroupBox {
    border: 1px solid #3d566e;
    border-radius: 4px;
    margin-top: 16px;
    padding: 16px 12px 12px 12px;
    background-color: #34495e;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 10px;
    color: #f39c12;
    font-size: 14px;
    font-weight: bold;
    left: 12px;
}

/* ===== 按钮样式 ===== */
QPushButton {
    background-color: #3498db;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 3px;
    font-size: 13px;
    font-weight: bold;
    min-height: 28px;
}

QPushButton:hover {
    background-color: #2980b9;
}

QPushButton:pressed {
    background-color: #1a5276;
}

QPushButton:disabled {
    background-color: #7f8c8d;
    color: #bdc3c7;
}

/* 警告按钮 */
QPushButton[warningBtn="true"] {
    background-color: #e74c3c;
}
QPushButton[warningBtn="true"]:hover {
    background-color: #c0392b;
}

/* 成功按钮 */
QPushButton[successBtn="true"] {
    background-color: #27ae60;
}
QPushButton[successBtn="true"]:hover {
    background-color: #229954;
}

/* 次要按钮 */
QPushButton[secondaryBtn="true"] {
    background-color: #7f8c8d;
}
QPushButton[secondaryBtn="true"]:hover {
    background-color: #566573;
}

/* ===== 输入框样式 ===== */
QLineEdit {
    border: 1px solid #3d566e;
    padding: 6px 10px;
    border-radius: 3px;
    background-color: #2c3e50;
    color: #ecf0f1;
    selection-background-color: #f39c12;
}

QLineEdit:focus {
    border: 1px solid #f39c12;
}

QLineEdit:disabled {
    background-color: #34495e;
    color: #7f8c8d;
    border-color: #3d566e;
}

/* ===== 列表样式 ===== */
QListWidget {
    border: 1px solid #3d566e;
    border-radius: 3px;
    background-color: #2c3e50;
    color: #ecf0f1;
    padding: 4px;
}

QListWidget::item {
    padding: 8px;
    border-bottom: 1px solid #34495e;
}

QListWidget::item:last-child {
    border-bottom: none;
}

QListWidget::item:selected {
    background-color: #f39c12;
    color: #2c3e50;
}

QListWidget::item:hover:!selected {
    background-color: #3d566e;
}

/* ===== 表格样式 ===== */
QTableWidget {
    border: 1px solid #3d566e;
    border-radius: 3px;
    background-color: #34495e;
    color: #ecf0f1;
    gridline-color: #3d566e;
    outline: 0;
}

QTableWidget::item {
    padding: 8px;
}

QTableWidget::item:selected {
    background-color: #f39c12;
    color: #2c3e50;
}

QHeaderView::section {
    background-color: #1a252f;
    padding: 10px;
    border: none;
    border-right: 1px solid #34495e;
    border-bottom: 1px solid #34495e;
    font-weight: bold;
    color: #f39c12;
    font-size: 13px;
}

QHeaderView::section:last {
    border-right: none;
}

QTableCornerButton::section {
    background-color: #1a252f;
    border: none;
}

/* ===== 标签样式 ===== */
QLabel {
    color: #ecf0f1;
}

QLabel[title="true"] {
    font-size: 18px;
    font-weight: bold;
    color: #f39c12;
    padding: 8px 0;
}

QLabel[subtitle="true"] {
    font-size: 12px;
    color: #95a5a6;
}

/* 图像显示区域 */
QLabel#lblTemplateImage,
QLabel#lblTestImage,
QLabel#lblResultImage {
    background-color: #1a252f;
    border: 2px dashed #3d566e;
    color: #7f8c8d;
    font-size: 14px;
    border-radius: 4px;
}

/* ===== 菜单栏样式 ===== */
QMenuBar {
    background-color: #1a252f;
    color: #ecf0f1;
    padding: 2px 4px;
    border-bottom: 1px solid #34495e;
}

QMenuBar::item {
    padding: 8px 16px;
    background-color: transparent;
}

QMenuBar::item:selected {
    background-color: #f39c12;
    color: #2c3e50;
    border-radius: 2px;
}

QMenu {
    background-color: #34495e;
    border: 1px solid #3d566e;
    color: #ecf0f1;
}

QMenu::item {
    padding: 8px 40px 8px 30px;
}

QMenu::item:selected {
    background-color: #f39c12;
    color: #2c3e50;
}

QMenu::separator {
    height: 1px;
    background-color: #3d566e;
    margin: 4px 10px;
}

/* ===== 状态栏样式 ===== */
QStatusBar {
    background-color: #1a252f;
    color: #95a5a6;
    border-top: 1px solid #34495e;
}

QStatusBar::item {
    border: none;
}

/* ===== 分割器样式 ===== */
QSplitter::handle {
    background-color: #34495e;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #f39c12;
}

/* ===== 滚动条样式 ===== */
QScrollBar:vertical {
    background-color: #2c3e50;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #7f8c8d;
    min-height: 30px;
    border-radius: 0;
}

QScrollBar::handle:vertical:hover {
    background-color: #f39c12;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #2c3e50;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #7f8c8d;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #f39c12;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ===== 信息提示样式 ===== */
QLabel[infoLabel="true"] {
    background-color: #34495e;
    border: 1px solid #3d566e;
    border-radius: 3px;
    padding: 8px;
    color: #bdc3c7;
}

/* ===== 对话框样式（避免被全局 QWidget/QLabel 浅色文字污染） ===== */
/* QMessageBox 使用系统原生主题（浅色背景 + 深色文字），与标题栏一致 */
QMessageBox {
    background-color: #ffffff;
}
QMessageBox QLabel {
    color: #2c3e50;
    background-color: transparent;
    font-size: 13px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
}
QMessageBox QPushButton {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #bdc3c7;
    padding: 6px 20px;
    border-radius: 3px;
    min-width: 80px;
    min-height: 16px;
    font-size: 13px;
}
QMessageBox QPushButton:hover {
    background-color: #ecf0f1;
    border-color: #3498db;
    color: #2980b9;
}
QMessageBox QPushButton:pressed {
    background-color: #d5dbdb;
}